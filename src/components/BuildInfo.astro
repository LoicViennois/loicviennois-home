---
import { REPO_URL } from '../lib/links';

// Vercel exposes the deployed commit at build time.
const commitSha = process.env.VERCEL_GIT_COMMIT_SHA ?? 'dev';
const commitUrl =
  commitSha !== 'dev' ? `${REPO_URL}/commit/${commitSha}` : REPO_URL;
---

<footer
  data-testid="build-info"
  class="fixed bottom-2 left-2 z-30 rounded-full bg-bg/80 px-2 py-0.5 text-xs text-ink-soft backdrop-blur-sm"
>
  Build{' '}
  <a
    href={commitUrl}
    title={commitSha}
    rel="noopener"
    class="font-mono underline hover:text-ink"
  >
    {commitSha.slice(0, 7)}
  </a>
</footer>
