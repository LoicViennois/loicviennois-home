---
// A faint, fixed field of stars behind the page. Positions, sizes, brightness
// and tints are drawn from a seeded generator at build time, so the sky is
// irregular but identical on every load. Two tiles of coprime sizes overlap,
// which keeps the repeat from ever lining up into a visible grid. Clicking or
// tapping the background adds a star under the pointer, with a brief flare.

import { scatter } from '../lib/stars';

const layers = [
  { id: 'stars-a', size: 613, stars: scatter(1987, 613, 70) },
  { id: 'stars-b', size: 419, stars: scatter(2026, 419, 26) },
];
---

<svg
  aria-hidden="true"
  focusable="false"
  class="pointer-events-none fixed inset-0 -z-10 size-full"
>
  <defs>
    {layers.map(({ id, size, stars }) => (
      <pattern id={id} width={size} height={size} patternUnits="userSpaceOnUse">
        {stars.map(({ x, y, r, opacity, tint }) => (
          <circle
            cx={x}
            cy={y}
            r={r}
            fill-opacity={opacity}
            class={`star-${tint}`}
          />
        ))}
      </pattern>
    ))}
  </defs>
  {layers.map(({ id }) => (
    <rect
      class="starfield-sky"
      width="100%"
      height="100%"
      fill={`url(#${id})`}
    />
  ))}
  <g data-added-stars></g>
</svg>

<script>
  import { makeStar } from '../lib/stars';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  // Beyond this, each new star replaces the oldest added one.
  const MAX_ADDED = 300;
  // A pointer that travels further than this is a drag, not a tap.
  const TAP_SLOP = 8;
  const INTERACTIVE = 'a, button, input, select, textarea, label, summary';

  const group = document.querySelector<SVGGElement>('[data-added-stars]');
  let press: { id: number; x: number; y: number } | undefined;

  // Pointer events rather than click: iOS does not send clicks for taps on
  // non-interactive content, and a scrolling touch ends in pointercancel.
  document.addEventListener('pointerdown', (event) => {
    const onControl =
      event.target instanceof Element && event.target.closest(INTERACTIVE);
    press =
      event.isPrimary && event.button === 0 && !onControl
        ? { id: event.pointerId, x: event.clientX, y: event.clientY }
        : undefined;
  });

  document.addEventListener('pointercancel', () => {
    press = undefined;
  });

  document.addEventListener('pointerup', (event) => {
    const start = press;
    press = undefined;
    if (!group || start?.id !== event.pointerId) return;
    const moved = Math.hypot(event.clientX - start.x, event.clientY - start.y);
    // Selecting text should not leave a star behind.
    if (moved > TAP_SLOP || !(window.getSelection()?.isCollapsed ?? true)) {
      return;
    }

    // The sky is fixed to the viewport, so client coordinates are sky coordinates.
    const { x, y, r, opacity, tint } = makeStar(
      Math.random,
      event.clientX,
      event.clientY,
    );
    const star = document.createElementNS(SVG_NS, 'circle');
    star.setAttribute('cx', String(x));
    star.setAttribute('cy', String(y));
    star.setAttribute('r', String(r));
    star.setAttribute('class', `star-${tint} star-added`);
    star.style.setProperty('--brightness', String(opacity));
    group.append(star);

    if (group.childElementCount > MAX_ADDED) {
      group.firstElementChild?.remove();
    }
  });
</script>

<!-- Global: the stars added on click are created at runtime, outside Astro's scoping. -->
<style is:global>
  .starfield-sky {
    opacity: var(--stars-opacity);
    transition: opacity 250ms;
  }

  .star-white {
    --tint: var(--star-white);
  }

  .star-cool {
    --tint: var(--star-cool);
  }

  .star-warm {
    --tint: var(--star-warm);
  }

  .star-white,
  .star-cool,
  .star-warm {
    fill: var(--tint);
  }

  /* A new star flares above the rest of the sky, then settles among it. */
  .star-added {
    fill-opacity: var(--brightness);
    opacity: var(--stars-opacity);
    transform-box: fill-box;
    transform-origin: center;
    animation: star-flare 1.6s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  @keyframes star-flare {
    from {
      fill-opacity: 1;
      opacity: 1;
      transform: scale(3.2);
      filter: drop-shadow(0 0 4px var(--tint))
        drop-shadow(0 0 1.5px var(--tint));
    }

    to {
      fill-opacity: var(--brightness);
      opacity: var(--stars-opacity);
      transform: scale(1);
      filter: drop-shadow(0 0 0 transparent) drop-shadow(0 0 0 transparent);
    }
  }
</style>
