---
import AboutDialog from './AboutDialog.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL } from '../lib/links';

const iconButton =
  'grid size-9 cursor-pointer place-items-center rounded-full text-ink-soft transition hover:bg-tint hover:text-ink active:scale-90';
---

<header class="sticky top-0 z-40 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-2 px-4 lg:h-16 lg:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-lg"
      aria-label="Loïc Viennois, home"
    >
      <Logo />
      <span class="text-lg font-bold tracking-tight whitespace-nowrap">
        Loïc Viennois
      </span>
    </a>
    <nav aria-label="Site" class="flex items-center gap-1">
      <a
        href={GITHUB_URL}
        rel="me noopener"
        aria-label="GitHub profile"
        class={iconButton}
      >
        <Icon name="github" />
      </a>
      <button
        type="button"
        data-about-open
        aria-label="About"
        aria-haspopup="dialog"
        class={iconButton}
      >
        <Icon name="info" />
      </button>
      <ThemeToggle />
    </nav>
  </div>
</header>
<AboutDialog />
