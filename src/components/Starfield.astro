---
// A faint, fixed field of stars behind the page. Positions, sizes, brightness
// and tints are drawn from a seeded generator at build time, so the sky is
// irregular but identical on every load. Two tiles of coprime sizes overlap,
// which keeps the repeat from ever lining up into a visible grid.

type Tint = 'white' | 'cool' | 'warm';

interface Star {
  x: number;
  y: number;
  r: number;
  opacity: number;
  tint: Tint;
}

function mulberry32(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const round = (value: number) => Math.round(value * 100) / 100;

function scatter(seed: number, size: number, count: number): Star[] {
  const random = mulberry32(seed);
  return Array.from({ length: count }, () => {
    // Cubing skews towards small, dim stars with the odd bright one.
    const magnitude = random() ** 3;
    const roll = random();
    return {
      x: round(random() * size),
      y: round(random() * size),
      r: round(0.45 + magnitude * 1.25),
      opacity: round(0.35 + magnitude * 0.45 + random() * 0.2),
      tint: roll < 0.62 ? 'white' : roll < 0.84 ? 'cool' : 'warm',
    };
  });
}

const layers = [
  { id: 'stars-a', size: 613, stars: scatter(1987, 613, 70) },
  { id: 'stars-b', size: 419, stars: scatter(2026, 419, 26) },
];
---

<svg
  aria-hidden="true"
  focusable="false"
  class="starfield pointer-events-none fixed inset-0 -z-10 size-full"
>
  <defs>
    {layers.map(({ id, size, stars }) => (
      <pattern id={id} width={size} height={size} patternUnits="userSpaceOnUse">
        {stars.map(({ x, y, r, opacity, tint }) => (
          <circle
            cx={x}
            cy={y}
            r={r}
            fill-opacity={opacity}
            class={`star-${tint}`}
          />
        ))}
      </pattern>
    ))}
  </defs>
  {layers.map(({ id }) => (
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  ))}
</svg>

<style>
  .starfield {
    opacity: var(--stars-opacity);
    transition: opacity 250ms;
  }

  .star-white {
    fill: var(--star-white);
  }

  .star-cool {
    fill: var(--star-cool);
  }

  .star-warm {
    fill: var(--star-warm);
  }
</style>
