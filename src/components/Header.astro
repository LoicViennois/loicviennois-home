---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-2 px-4 lg:h-16 lg:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-lg"
      aria-label="Loïc Viennois, home"
    >
      <Logo />
      <span class="text-lg font-bold tracking-tight whitespace-nowrap">
        Loïc Viennois
      </span>
    </a>
    <ThemeToggle />
  </div>
</header>
